# Conexión a Supabase (Transaction pooler). NO subas el archivo .env a GitHub.
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_USER=postgres.TU_PROJECT_REF
DB_PASSWORD=
DB_NAME=postgres
DB_PORT=6543

# Deben ser IGUALES en los tres microservicios
JWT_SECRET_KEY=
API_KEY=

# Solo para ejecución local
SERVER_HOST=127.0.0.1
# SERVER_PORT=8001  <- servicio_rutas
# SERVER_PORT=8002  <- servicio_operaciones
# SERVER_PORT=5003  <- servicio_monitoreo
